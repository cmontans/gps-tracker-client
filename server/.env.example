# PostgreSQL Database URL
# For Railway: You can get this from your PostgreSQL service in Railway dashboard
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/gps_tracker

# Node environment (development/production)
NODE_ENV=development

# Database TLS (optional)
# The DB connection verifies the server certificate by default. If your managed
# Postgres provider uses a cert that doesn't validate against public CAs, either:
#   1. Provide the provider's CA certificate (preferred):
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#   2. Or explicitly disable verification (understand the MITM risk):
# DATABASE_SSL_NO_VERIFY=true
